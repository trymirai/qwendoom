-    int		size;
 
-    mainzone = (memzone_t *)I_ZoneBase (&size);
-    mainzone->size = size;
+    zone->size = size;
 
     // set the entire zone to one free block
-    mainzone->blocklist.next =
-	mainzone->blocklist.prev =
-	block = (memblock_t *)( (byte *)mainzone + sizeof(memzone_t) );
+    zone->blocklist.next =
+	zone->blocklist.prev =
+	block = (memblock_t *)( (byte *)zone + sizeof(memzone_t) );
 
-    mainzone->blocklist.user = (void *)mainzone;
-    mainzone->blocklist.tag = PU_STATIC;
-    mainzone->rover = block;
+    zone->blocklist.user = (void *)zone;
+    zone->blocklist.tag = PU_STATIC;
+    zone->rover = block;
 	
-    block->prev = block->next = &mainzone->blocklist;
+    block->prev = block->next = &zone->blocklist;
 
-    // free block
+    // a free block.
     block->tag = PU_FREE;
     
-    block->size = mainzone->size - sizeof(memzone_t);
+    block->size = zone->size - sizeof(memzone_t);
 }
 
+void Z_Init (void)
+{
+    int		size;
 
+    mainzone = (memzone_t *)I_ZoneBase (&size);
+    Z_InitZone (mainzone, size);
+
+    if (qd_measure_levels)
+    {
+        // doom/measure.py --maps: a large level zone in the host heap, to size levels that do
+        // not fit sim RAM (the sim cannot run on it)
+        levelzone = (memzone_t *)I_ZoneBase (&size);
+        Z_InitZone (levelzone, size);
+        return;
+    }
+    levelzone = (memzone_t *)__sim_ram_end;
+    Z_InitZone (levelzone, QD_RAM_BASE + QD_RAM_SIZE - (uintptr_t)__sim_ram_end);
+}
