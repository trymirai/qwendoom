+void*
+Z_Malloc
+( int		size,
+  int		tag,
+  void*		user )
+{
+    return Z_MallocIn (tag == PU_LEVEL || tag == PU_LEVSPEC ? levelzone : mainzone,
+                       size, tag, user);
