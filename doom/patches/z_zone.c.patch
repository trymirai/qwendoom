 memzone_t*	mainzone;
 
+// qwendoom: a second zone in sim RAM, from the end of the sim's data (linker script) to
+// 256 KB, for everything the sim allocates or touches per level (PU_LEVEL, PU_LEVSPEC)
+memzone_t*	levelzone;
+extern byte	__sim_ram_end[];
 
+static memzone_t *Z_ZoneOf(void *ptr)
+{
+    return (byte *)ptr >= (byte *)levelzone && (byte *)ptr < (byte *)levelzone + levelzone->size
+         ? levelzone : mainzone;
+}
 
